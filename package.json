{
  "name": "code-reviewer",
  "version": "0.1.0",
  "private": true,
  "description": "Standing multi-pillar code reviewer for pull requests: CLI, Claude Code skills, and evals.",
  "license": "MIT",
  "author": "Jonathan Ong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonathanong/code-reviewer.git"
  },
  "bin": {
    "code-reviewer": "bin/code-reviewer.mts",
    "vouchington-reviewer": "bin/code-reviewer.mts"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "pnpm run oxlint && pnpm run oxfmt:check",
    "oxlint": "oxlint --type-aware --deny-warnings",
    "oxfmt": "oxfmt",
    "oxfmt:check": "oxfmt --check",
    "actionlint": "github-actionlint",
    "vendor": "node scripts/vendor-yaml.mts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "code-reviewer": "link:.",
    "esbuild": "^0.28.2",
    "eslint-plugin-no-mistakes": "^0.109.97",
    "github-actionlint": "^1.7.12",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24"
  }
}
