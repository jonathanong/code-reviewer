import { copyFileSync, readFileSync, writeFileSync } from 'node:fs'
import { fileURLToPath } from 'node:url'

import { build } from 'esbuild'

/**
 * Bundles the `yaml` package into `vendor/yaml.mjs`, the one file runtime code imports, because a
 * plugin install has no `node_modules`. The output depends only on the installed `yaml` version.
 */
const here = (path: string) => fileURLToPath(new URL(path, import.meta.url))
const pkg = JSON.parse(readFileSync(here('../node_modules/yaml/package.json'), 'utf8')) as {
  version: string
  license: string
}

const result = await build({
  stdin: {
    contents: "export { parseDocument, visit } from 'yaml'",
    resolveDir: here('..'),
  },
  bundle: true,
  format: 'esm',
  platform: 'neutral',
  target: 'node24',
  write: false,
  legalComments: 'none',
  banner: {
    js: [
      `// Bundled from yaml@${pkg.version} (${pkg.license}), https://github.com/eemeli/yaml.`,
      '// Generated by scripts/vendor-yaml.mts (pnpm run vendor); do not edit.',
      '// The license text is in vendor/yaml.LICENSE.',
    ].join('\n'),
  },
})

const [output] = result.outputFiles
if (output === undefined) throw new Error('esbuild produced no output')
writeFileSync(here('../vendor/yaml.mjs'), output.text)
copyFileSync(here('../node_modules/yaml/LICENSE'), here('../vendor/yaml.LICENSE'))
