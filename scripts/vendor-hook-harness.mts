import { readFileSync, writeFileSync } from 'node:fs'
import { fileURLToPath } from 'node:url'

import { build } from 'esbuild'

/**
 * Bundles hook-harness's client (`hook-harness/client`) into `vendor/hook-harness-client.mjs`, the
 * one file runtime code imports, because a plugin install has no `node_modules`. The output depends
 * only on the installed `hook-harness` version.
 */
const here = (path: string) => fileURLToPath(new URL(path, import.meta.url))
const pkg = JSON.parse(readFileSync(here('../node_modules/hook-harness/package.json'), 'utf8')) as {
  version: string
  license: string
}

const result = await build({
  stdin: {
    contents:
      "export { AuthError, BadRequestError, NotLoggedInError, OutOfScopeError, RelayError, UnauthorizedError, pollEvents, resolveClient } from 'hook-harness/client'",
    resolveDir: here('..'),
  },
  bundle: true,
  format: 'esm',
  platform: 'node',
  target: 'node24',
  write: false,
  legalComments: 'none',
  banner: {
    js: [
      `// Bundled from hook-harness@${pkg.version} (${pkg.license}), https://github.com/jongleberry/hook-harness.`,
      '// Generated by scripts/vendor-hook-harness.mts (pnpm run vendor); do not edit.',
    ].join('\n'),
  },
})

const [output] = result.outputFiles
if (output === undefined) throw new Error('esbuild produced no output')
writeFileSync(here('../vendor/hook-harness-client.mjs'), output.text)
